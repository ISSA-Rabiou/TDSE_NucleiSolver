#!/bin/bash
#
# Build the executable (uncomment the next line to clean first)
DIR_TD=/Users/issa/Developpements/TD_Schrod_Rabiou
EXE=$DIR_TD/TD_SCHROD.x


# Read the number of basis functions as the first argument
nb=$1

# Compute nq as nb + 250
nq=$((nb + 250))

# Print nb and nq for logging
echo "nb = $nb, nq = $nq"

# Create results directory and move into it
mkdir -p results_doublewell_nb$nb
cd results_doublewell_nb$nb

# Run the TD_SCHROD.x program with input redirected from here-document
$EXE<< ** > resultat_doublewell_H.lua

&potential
    pot_name  = 'DoubleWell'
    ndim      = 2
    nsurf     = 1
    read_nml  = t
/

&DoubleWell
    a = 10.0
    b = 50.0
    m = 1.0, 1.0     ! masse : système = 1.0, bath = 1.0
    w = 8.51982       ! pulsation du bath
    c = 0.39         ! couplage système-bath
/

&basis_nd name='dp' nb_basis=3 /
&basis_nd name='boxab' nb=$nb nq=$nq A=-0.7 B=0.7 /
&basis_nd name='boxab' nb=$nb nq=$nq A=-0.2 B=0.2 /
&basis_nd name='el' nb=1 /

&defGWP ndim=2 Elecindex=1 Coef=(1.0, 0.0) /
&defWP0 sigma=1.2909944487358056 Beta=0.0 Qeq=2.0 imp_k=0.0 gamma=0.0 /
&defWP0 sigma=1.2909944487358056 Beta=0.0 Qeq=2.0 imp_k=0.0 gamma=0.0 /

&prop
    t0=0.0 tf=60.0 delta_t=0.1
    eps=1.e-20 max_iter=500
    propa_name='hagedorn'
    propa_name2='taylor'
    Beta=t P=t renorm=t
/