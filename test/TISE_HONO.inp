#!/usr/bin/env bash

NB=$1
NQ=$((NB + 2))

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
OUT_DIR="$ROOT_DIR/test/results_TISE_HONO"
mkdir -p "$OUT_DIR"
cd "$OUT_DIR" || exit 1

"$ROOT_DIR/TD_SCHROD.x" > "HONO.log" 2>&1 <<EOF

&coordQMLpot
coord_type = 'CURV'
construction_type = 'developed'
sym_type   = 'SYM'
model_type = 'QML'
pot0       = 0.0
/

&system
  printlev = 2
/

&potential
  model_name = 'HONO'
  option    = 1
  adiabatic = F
  nsurf     = 1
  ndim      = 6
/

&variables
  Old_Qtransfo = F
  nb_Qtransfo  = 3
  nrho         = 2
  Cart_Type = 'BF'
  JJ = 0          
/

&Coord_transfo name_transfo='bunch' nb_vect=3 inTOout=F /
O O H H
1 2   R1: O1->O2 (zBF)
1 3   R2: O1->H3
4 2   R3: H4->O2

&Coord_transfo name_transfo='poly' cos_th=F /
  &vector nb_vect=2 Frame=T /
  &vector Frame=F /
  &vector Frame=F /

&Coord_transfo name_transfo='active' /
1 1 1 1 1 1

&minimum read_itQ0transfo=2 unit='angs' /
ROO 1.4
RH1 1.0
A1  100.
RH2 1.0
A2  100.
D   60.

&basis_nd name='dp' nb_basis=7 /
&basis_nd name='HO' nb=$NB nq=$NQ use_initial_gwp=T debug=F /
&basis_nd name='HO' nb=$NB nq=$NQ use_initial_gwp=T debug=F /
&basis_nd name='HO' nb=$NB nq=$NQ use_initial_gwp=T debug=F /
&basis_nd name='HO' nb=$NB nq=$NQ use_initial_gwp=T debug=F /
&basis_nd name='HO' nb=$NB nq=$NQ use_initial_gwp=T debug=F /
&basis_nd name='HO' nb=$NB nq=$NQ use_initial_gwp=T debug=F /
&basis_nd name='el' nb=1 /

&defGWP ndim=6 Elecindex=1 Coef=(1.,0.) /
&defWP0 sigma=0.19491027892874252 Beta=0.0 Qeq=2.6967325858163527 imp_k=0.0 gamma=0.0 /
&defWP0 sigma=0.25856393668211736 Beta=0.0 Qeq=1.8229121979747311 imp_k=0.0 gamma=0.0 /
&defWP0 sigma=0.24884597198956887 Beta=0.0 Qeq=1.7776420181002541 imp_k=0.0 gamma=0.0 /
&defWP0 sigma=0.22754434280808850 Beta=0.0 Qeq=2.2133264189824171 imp_k=0.0 gamma=0.0 /
&defWP0 sigma=0.17684836443314877 Beta=0.0 Qeq=1.9315016999563468 imp_k=0.0 gamma=0.0 /
&defWP0 sigma=0.44379545411652210 Beta=0.0 Qeq=3.1415926535897931 imp_k=0.0 gamma=0.0 /

&prop dynamics='TISE' tise_method='arpack' tise_nstates=50 tise_max_iter=500 tise_tol=1.e-10 
energy_unit='cm-1' tise_energy_file='HONO_TISE_energies.txt' 
tise_transition_file='HONO_TISE_transitions.txt' debug=F  /
EOF
