#!/bin/bash
#
#make clean
#make

DIR_TD=/Users/issa/Developpements/TD_Schrod_Rabiou
EXE=${DIR_TD}/TD_SCHROD.x


mkdir -p results_H2O_similarity_hagedorn
cd results_H2O_similarity_hagedorn || exit

$EXE << ** > resultat_H2O_similarity_hagedorn.lua

&coordQMLpot
coord_type = 'CURV'
construction_type = 'similarity'
sym_type   = 'SYM'
model_type = 'QML'
pot0       = 0.0
/

&system
  printlev = 2
/

&variables
  Old_Qtransfo = F
  nb_Qtransfo  = 2
  WriteT = F
  Cart_Type = "BF"
  JJ=0
  Tana=t 
  FortranForm=f
/


&Coord_transfo name_transfo='zmat' nat=3 /
O
H 1
H 1 2

&Coord_transfo name_transfo='active' /
1  1  1

&minimum /
R1 1.
R2 1.
a2 1.83


&potential
    pot_name  = 'H2O'
    option=1
    adiabatic = f
    nsurf = 1
    ndim = 3
   /
   &basis_nd name='dp' nb_basis=4/
    &basis_nd name='HO' nb=5 nq=8 Q0=1.8107934896 SCALEQ= 5.3461602503 Imp_k=0.0  alpha =( 28.5814294224,0.00)  /
    &basis_nd name='HO' nb=5 nq=8  Q0=1.8107934896 SCALEQ= 5.3461602503 Imp_k=0.0  alpha =( 28.5814294224,0.00)  /
    &basis_nd name='HO' nb=5 nq=8 Q0=1.8230843491 SCALEQ=4.1722088823 Imp_k=0.0  alpha =( 17.4073269576,0.0)/
    &basis_nd name= 'el' nb=1/

 &defGWP ndim=3  Elecindex= 1 Coef=(1.,0.)/
 &defWP0  sigma=  0.2645288387 Beta=0.0 Qeq=1.8107934896  imp_k=0.0 gamma=0.0 /
 &defWP0  sigma= 0.2645288387  Beta=0.0 Qeq=1.8107934896  imp_k=0.0 gamma=0.0 /
 &defWP0  sigma=0.3389603930  Beta=0.0 Qeq=1.8230843491   imp_k=0.0 gamma=0.0 /

&prop t0  = 0  tf = 50. delta_t = 0.10  eps=1.e-20
      max_iter = 500   propa_name='hagedorn'  propa_name2='taylor' Beta=T  P=T renorm=F  diag_H=.true.  /
**
