#!/bin/bash

DIR_TD=/Users/issa/Developpements/TD_Schrod_Rabiou
EXE=${DIR_TD}/TD_SCHROD.x

mkdir -p results_H2_developed_std
cd results_H2_developed_std || exit

"$EXE"<< ** > resultat_H2_developed_std.lua
&coordQMLpot
coord_type = 'CURV'
construction_type = 'developed'
sym_type='SYM'
model_type='QML'
pot0=0.0
/
&system
 printlev=2
/
&variables
 Old_Qtransfo=F
 nb_Qtransfo=2
 WriteT=F
 Cart_Type='BF'
 JJ=0
 Tana=t
 FortranForm=f
/
&Coord_transfo name_transfo='zmat' nat=2 /
H
H 1

&Coord_transfo name_transfo='active' /
1

&minimum /
R1 1.401

&potential
 pot_name='H2'
 option=3
 adiabatic=f
 nsurf=1
 ndim=1
/
Qdyn_TO_QQMLib 1
&basis_nd name='dp' nb_basis=2/
&basis_nd name='HO' nb=20 nq=25 Q0=1.401 SCALEQ=5.0 Imp_k=0.0 alpha=(15.0,0.0)/
&basis_nd name='el' nb=1/
&defGWP ndim=1 Elecindex=1 Coef=(1.,0.)/
&defWP0 sigma=0.35 Beta=0.0 Qeq=1.401 imp_k=0.0 gamma=0.0 /
&prop t0=0 tf = 50. delta_t = 0.05 eps=1.e-20 max_iter = 500
    propa_name='non_hagedorn'
    propa_name2='taylor'
    Beta=F
    P=F
    renorm=F
    diag_H=.true.
/

**