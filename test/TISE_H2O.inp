#!/bin/bash
#
#make clean
#make

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DIR_TD="$ROOT_DIR"

mkdir -p "$ROOT_DIR/test/results_TISE_H2O"
cd "$ROOT_DIR/test/results_TISE_H2O" || exit


$DIR_TD/TD_SCHROD.x << ** > resultat_H2O.lua

&coordQMLpot
coord_type = 'CURV'
sym_type   = 'SYM'
model_type = 'QML'
pot0       = 0.0
/

&system
  printlev = 2
/

&variables
  Old_Qtransfo = F
  nb_Qtransfo  = 2
  WriteT = F
  Cart_Type = "BF"
  JJ=0
  Tana=t 
  FortranForm=f
/


&Coord_transfo name_transfo='zmat' nat=3 /
O
H 1
H 1 2

&Coord_transfo name_transfo='active' /
1  1  1

&minimum /
R1 1.
R2 1.
a2 1.83


&potential
    pot_name  = 'H2O'
    option=1
    adiabatic = f
    nsurf = 1
    ndim = 3
   /
   &basis_nd name='dp' nb_basis=4/
    &basis_nd name='HO' nb=10 nq=12 Q0=1.8107934896 SCALEQ=5.3461602503 Imp_k=0.0  alpha=( 28.5814294224,0.0) /
    &basis_nd name='HO' nb=10 nq=12 Q0=1.8107934896 SCALEQ=5.3461602503 Imp_k=0.0  alpha=( 28.5814294224,0.0) /
    &basis_nd name='HO' nb=10 nq=12 Q0=1.8230843491 SCALEQ=4.1722088823 Imp_k=0.0  alpha=( 17.4073269576,0.0) /
    &basis_nd name='el' nb=1 /

 &defGWP ndim=3  Elecindex= 1 Coef=(1.,0.)/
 &defWP0  sigma=  0.2645288387 Beta=0.0 Qeq=1.8107934896  imp_k=1.0 gamma=0.0 /
 &defWP0  sigma= 0.2645288387  Beta=0.0 Qeq=1.8107934896  imp_k=1.0 gamma=0.0 /
 &defWP0  sigma=0.3389603930  Beta=0.0 Qeq=1.8230843491   imp_k=1.0 gamma=0.0 /

&prop t0=0.0 tf=0.0 delta_t=1.0 eps=1.e-10 max_iter=500 propa_name='non_hagedorn' propa_name2='taylor' Beta=F P=F
 renorm=F dynamics='TISE' tise_method='dense' tise_nstates=3 tise_max_iter=20 tise_tol=1.e-8 energy_unit='cm-1' 
 tise_energy_file='H2O_TISE_energies.dat' tise_transition_file='H2O_TISE_transitions.txt' /
**
