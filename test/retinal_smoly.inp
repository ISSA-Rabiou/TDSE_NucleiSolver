#!/bin/bash
#
#make clean
#make

DIR_TD=../
DIR_TD=/Users/issa/Developpements/TD_Schrod_Rabiou

nb2=50
nq2=60

nb1=256
nq1=256


mkdir -p results_retinal_std
cd results_retinal_std || exit

$DIR_TD/TD_SCHROD.x << ** > resultat_retinal_std.lua

&coordQMLpot
coord_type = 'CC'
sym_type   = 'SYM'
model_type = 'QML'
pot0       = 0.0
/


&potential
    pot_name  = 'Retinal_JPCB2000'
    option=1
    adiabatic = f
    nsurf = 2
    ndim = 2
   /
   &basis_nd name='smolyak' nb_basis=3 LB=20 LG=30 A_smol=5 B_smol=2/
   &basis_nd name='fourier' nb=$nb1 nq=$nq1 SCALEQ= 7.8092043201 Imp_k=0.0  alpha =( 60.9836721136,0.0)/
    &basis_nd name='HO' nb=$nb2 nq=$nq2  SCALEQ= 1.0000000000 Imp_k=0.0  alpha =( 1.0,0.00)  /
      &basis_nd name= 'el' nb=2/

 &defGWP ndim=2  Elecindex=2 Coef=(1.,0.)/
 &defWP0  sigma= 0.1810957307 Beta=0.0 Qeq=0.0   imp_k=0.0 gamma=0.0 /
 &defWP0  sigma=1.4142135624  Beta=0.0 Qeq=0.0   imp_k=0.0 gamma=0.0 /

&prop t0  = 0  tf = 30 delta_t = 10  eps=1.e-20
      max_iter = 500   propa_name='non_hagedorn'  propa_name2='taylor' Beta=F  P=F renorm=F  /
**
