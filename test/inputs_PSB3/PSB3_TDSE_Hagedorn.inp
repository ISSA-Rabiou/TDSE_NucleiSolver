! PSB3 3D, propagation dépendante du temps avec paquets Hagedorn.
! QML PSB3: Q=(BLA, torsion, HOOP); option=1 (paramétrisation publiée).
! PubliUnit=F: saisir BLA en angstroms (converti en bohr par QML), torsion/HOOP en radians.
&coordQMLpot
  coord_type='CC'
  sym_type='SYM'
  model_type='QML'
  pot0=0.0
/
&potential
  pot_name='PSB3'
  ndim=3
  nsurf=2
  option=1
  adiabatic=F
  PubliUnit=F
/
&basis_nd name='dp' nb_basis=4 /
&basis_nd name='HO' nb=20 nq=30 use_initial_gwp=T Q0=0.172459 SCALEQ=1.0 Imp_k=0.0 alpha=(1.0,0.0) /
&basis_nd name='HO' nb=30 nq=40 use_initial_gwp=T Q0=-3.14 SCALEQ=1.0 Imp_k=0.0 alpha=(1.0,0.0) /
&basis_nd name='HO' nb=24 nq=32 use_initial_gwp=T Q0=0.0 SCALEQ=1.0 Imp_k=0.0 alpha=(1.0,0.0) /
&basis_nd name='el' nb=2 /
&defGWP ndim=3 Elecindex=2 Coef=(1.0,0.0) source='qmodel' /
&defWP0 sigma=0.01 Beta=0.0 Qeq=0.172459 imp_k=0.0 gamma=0.0 /
&defWP0 sigma=0.20 Beta=0.0 Qeq=-3.14 imp_k=0.0 gamma=0.0 /
&defWP0 sigma=0.20 Beta=0.0 Qeq=0.0 imp_k=0.0 gamma=0.0 /
&prop t0=0.0 tf=1000.0 delta_t=0.25 eps=1.e-12 max_iter=500
  propa_name='hagedorn_taylor' Beta=T P=T renorm=F
  write_E=T write_Norm=T write_auto_cor=T write_validation=T debug=F /
