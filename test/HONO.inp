#!/bin/bash
#
#make clean
#make

DIR_TD=../
DIR_TD=/Users/issa/Developpements/TD_Schrod_Rabiou

nb2=$1
nq2=$((nb2 + 5))

nb1=150
nq1=160


mkdir -p results_HONO
cd results_HONO

$DIR_TD/TD_SCHROD.x << ** > resultat_HONO.lua
&potential
    pot_name  = 'HONO'
    option=1
    adiabatic = f
    nsurf = 1
    ndim = 6
   /
 &variables
         Old_Qtransfo=f
         nb_Qtransfo=3
         nrho=2
         Tana=t
         FortranForm=t
         MCTDHForm=t
 /
 &Coord_transfo name_transfo='bunch' nb_vect=3 inTOout=f /
O O H H
1 2   R1: O1->O2 (zBF)
1 3   R2: O1->H3
4 2   R3: H4->O2

 &Coord_transfo name_transfo='poly' cos_th=f /
     &vector nb_vect=2 Frame=t /
       &vector Frame=f /
       &vector Frame=f /

 &Coord_transfo name_transfo='active' /
 1 1 1    1 1 1

 &minimum read_itQ0transfo=2 unit='angs' /
 ROO 1.4
 RH1 1.0
 A1  100.
 RH2 1.0
 A2  100.
 D    60.



   &basis_nd name='dp' nb_basis=3/
   &basis_nd name='fourier' nb=$nb1 nq=$nq1 SCALEQ=0.1810957307 Imp_k=0.0  alpha =( 60.9836721136,0.0)/
    &basis_nd name='HO' nb=$nb2 nq=$nq2  SCALEQ= 1.0000000000 Imp_k=0.0  alpha =( 1.0,0.00)  /
      &basis_nd name= 'el' nb=2/

 &defGWP ndim=2  Elecindex=2 Coef=(1.,0.)/
 &defWP0  sigma= 0.1810957307 Beta=0.0 Qeq=0.0   imp_k=0.0 gamma=0.0 /
 &defWP0  sigma=1.4142135624  Beta=0.0 Qeq=0.0   imp_k=0.0 gamma=0.0 /

&prop t0  = 0  tf  = 10000 delta_t =10.0  eps=1.e-20
      max_iter=500   propa_name='non_hagedorn'  propa_name2='taylor' Beta=F  P=F renorm=F  /
**
