# Disable the default rules
MAKEFLAGS += --no-builtin-rules --no-builtin-variables
#
$(info *********** IN makefile-extlib ****************)

slash := /
empty :=
space := $(empty) $(empty)

ifeq ($(LIBA),)
  $(error ERROR: LIBA is empty. You have to specify it!)
endif
$(info LIBA: $(LIBA))
# extract LibName from LIBA
LibName := $(dir $(LIBA))
LibName := $(subst $(slash),$(space),$(LibName))
LibName := $(lastword $(LibName))

# test LibName
ifeq ($(LibName),)
  $(error ERROR: LibName is empty. Problem with the extraction form $(LIBA))
endif
$(info LibName: $(LibName))

ifeq ($(BRANCH),)
  BRANCH := main
endif
$(info BRANCH: $(BRANCH))


LibVersion := "https://github.com/lauvergn/"$(LibName)"/archive/refs/heads/"$(BRANCH)".zip"
zipfile    := $(LibName).zip
LibDir     := $(LibName)_loc

# Source archives distributed with an application may already contain a
# checked-out library under its canonical name (for example EXT_Lib/Tnum-Tana).
# In that case use it directly. The old logic tried to create a link with the
# same name and could create EXT_Lib/Tnum-Tana/Tnum-Tana_loc -> Tnum-Tana_loc.
ifneq ($(wildcard $(LibName)/makefile)$(wildcard $(LibName)/Makefile),)
  LibDir := $(LibName)
endif

$(LIBA): $(LibName)
	@if [ "$(LibName)" = "Tnum-Tana" ]; then \
	  python3 "$(TD_SCHROD_ROOT)/scripts/apply_tnum_bunchpoly_fix.py" \
	    "$(LibDir)/SRC/Source_TnumTana_Coord/Qtransfo/BunchPolyTransfo.f90"; \
	fi
	$(MAKE) -C $(LibDir) lib

ifneq ($(LibDir),$(LibName))
$(LibName): $(LibDir)
	ln -s $(LibDir) $(LibName)
	@test -L $(LibName) || (echo The linked directory $(LibName) does not exist ; exit 1)
	@echo The directory, $(LibName), is linked to $(LibDir).
endif

$(LibDir):
	curl -LJ $(LibVersion) --output $(LibName).zip
	@test -f $(zipfile) || (echo $(zipfile) "does not exist" ; exit 1)
	unzip -d $(LibDir) $(zipfile)
	rm -f $(zipfile)
	@test -d $(LibDir) || (echo The directory $(LibDir) "does not exist" ; exit 1)
	cd $(LibDir) ; mv $(LibName)*/* $(LibName)*/.gitignore . ; rm -rf $(LibName)*
	rm -rf $(LibDir)/Ext_lib/*_loc
	@echo The library, $(LibName), with the branch $(BRANCH) is downloaded from github.
	@echo The directory, $(LibDir) is created.
