#!/bin/bash


CleanType=$1
CleanDIR=$2
CleanList=$3
RecClean=$4

if test -z "$RecClean"
then
  echo "RecClean is not defined."
  echo "=> It is set to 0 (no recursive cleaning)"
  RecClean=0
fi

echo "The script command is: \"$0 $@\""
echo CleanType: $CleanType
echo CleanDIR:  $CleanDIR
echo CleanList: $CleanList
echo RecClean:  $RecClean

if test -z "$CleanType"
then
  echo "The present script, cleanExtLib, has three arguments:"
  echo "    The first argument, the cleaning type: cleanall or cleanlocextlib"
  echo "    The second argument, the directory to be cleaned"
  echo "    The third argument, the list of module(s) to be cleaned"
  exit 1
fi

if test -z "$CleanList"
then
  echo No module to be cleaned!
  exit 0
fi

if test -z "$CleanDIR"
then
  echo No or empty second argument!
  exit 0
fi

if test ! -d "$CleanDIR"
then
  echo The directory $CleanDIR does not exist!
  exit 0
fi

if [ "$CleanType" = "cleanall" ]
then
  cd "$CleanDIR" || exit 1
  for dirlib in $CleanList
  do
    echo $dirlib

    # Remove only the compatibility link. A real canonical directory may
    # contain sources distributed with the application and must be preserved.
    if test -L "$dirlib"
    then
      rm -f "$dirlib"
    elif test -e "$dirlib"
    then
      echo "Keep existing source directory $dirlib"
    fi

    # Clean a real canonical checkout when present; otherwise clean the
    # downloaded *_loc checkout. Never delete the canonical source tree.
    clean_target=""
    if test -d "$dirlib" && { test -f "$dirlib/Makefile" || test -f "$dirlib/makefile"; }
    then
      clean_target="$dirlib"
    elif test -d "${dirlib}_loc"
    then
      clean_target="${dirlib}_loc"
    fi
    if test -n "$clean_target"
    then
      make -C "$clean_target" cleanall RECCLEAN="$RecClean"
    fi
  done
elif [ "$CleanType" = "cleanlocextlib" ]
then
  cd "$CleanDIR" || exit 1
  for dirlib in $CleanList
  do
    echo $dirlib

    # Remove only a compatibility symlink. A canonical source checkout is
    # part of the application and must not be deleted.
    if test -L "$dirlib"
    then
      rm -f "$dirlib"
    elif test -e "$dirlib"
    then
      echo "Keep existing source directory $dirlib"
    fi

    #remove the directory
    rm -rf "${dirlib}_loc"
    echo "Remove the ${dirlib}_loc directory."
  done
else
  echo "The present script, cleanExtLib, has three arguments:"
  echo "    The first argument, the cleaning type: cleanall or cleanlocextlib"
  echo "    The second argument, the directory to be cleaned"
  echo "    The third argument, the list of module(s) to be cleaned"
  exit 1
fi
